{
  "$schema": "https://json.schemastore.org/launchsettings.json",
  "profiles": {
    "Valkyrie": {
      "commandName": "Project",
      "dotnetRunMessages": true
    },
    "simulated-market": {
      "commandName": "Project",
      "dotnetRunMessages": true,
      "environmentVariables": {
        "MarketSimulatorConfiguration__Enabled": "true",
        "MarketSimulatorConfiguration__Source": "Synthetic"
      }
    },
    "historical-replay": {
      "commandName": "Project",
      "dotnetRunMessages": true,
      "environmentVariables": {
        "MarketSimulatorConfiguration__Enabled": "true",
        "MarketSimulatorConfiguration__Source": "LobsterReplay"
      }
    }
  }
}
